---
interface Props {
  title: string;
  description: string;
  image?: string;
  video?: string;
  demoUrl?: string;
  projectUrl?: string;
  tags: string[];
  featured?: boolean;
  featuredLabel?: string;
  art?: string;
  artVariant?: 'wislab' | 'tb';
  viewProjectLabel?: string;
  liveDemoLabel?: string;
}

const {
  title,
  description,
  image,
  video,
  demoUrl,
  projectUrl,
  tags,
  featured = false,
  featuredLabel,
  art,
  artVariant = 'wislab',
  viewProjectLabel,
  liveDemoLabel,
} = Astro.props;

// Primary link: internal project page first, else external demo.
const href = projectUrl || demoUrl;
const isExternal = !!href && href.startsWith('http');
const badgeLabel = projectUrl ? viewProjectLabel : liveDemoLabel;

// Generate poster URL from Cloudinary video URL.
const getVideoPoster = (videoUrl: string | undefined): string | undefined => {
  if (!videoUrl || !videoUrl.includes('cloudinary.com')) return undefined;
  return videoUrl.replace('/video/upload/', '/video/upload/so_0/').replace('.mp4', '.jpg');
};
const videoPoster = getVideoPoster(video);

const Thumb = href ? 'a' : 'div';
---

<article class:list={['pcard group', featured && 'pcard-featured']}>
  <Thumb
    class="thumb"
    {...href ? { href } : {}}
    {...isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
    aria-label={href ? `${badgeLabel}: ${title}` : undefined}
  >
    {video ? (
      <video class="media" autoplay muted loop playsinline poster={videoPoster}>
        <source src={video} type="video/mp4" />
      </video>
    ) : image ? (
      <img class="media" src={image} alt={title} loading="lazy" />
    ) : art ? (
      <div class:list={['art-panel', artVariant]}>
        <img class="art-logo" src={art} alt={title} loading="lazy" />
      </div>
    ) : (
      <div class="art-plain">
        <div class="deco"></div>
      </div>
    )}

    <div class="scrim" aria-hidden="true"></div>

    {featured && <span class="star" aria-hidden="true">{featuredLabel}</span>}

    {href && badgeLabel && (
      <span class="pbadge">{badgeLabel}</span>
    )}
  </Thumb>

  <div class="pbody">
    <h3 class="ptitle">{title}</h3>
    <p class="pdesc">{description}</p>
    <div class="ptags">
      {tags.map((tag) => (
        <span class="ptag">{tag}</span>
      ))}
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(150, 205, 176, 0.16);
    border-radius: 22px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .pcard:hover {
    transform: translateY(-5px);
    border-color: rgba(217, 172, 99, 0.4);
    box-shadow: 0 28px 54px -28px rgba(0, 0, 0, 0.7);
  }

  .thumb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 220px;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
  }

  .pcard-featured .thumb {
    height: 260px;
  }

  .media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.35s ease;
  }

  .art-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 34px;
    transition: transform 0.5s ease;
  }

  .art-logo {
    max-width: 80%;
    max-height: 82%;
    object-fit: contain;
  }

  .art-panel.wislab {
    background: radial-gradient(120% 120% at 30% 15%, var(--color-cream-light), var(--color-sand));
  }

  .art-panel.tb {
    background: radial-gradient(120% 120% at 72% 20%, #f6efdc, var(--color-sand));
  }

  .art-plain {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #14332c, #0f2621);
  }

  .art-plain .deco {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    background: rgba(150, 205, 176, 0.25);
    transform: rotate(8deg);
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 18, 0.55);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .thumb:hover .media {
    filter: brightness(0.6);
    transform: scale(1.05);
  }

  .thumb:hover .art-panel {
    transform: scale(1.04);
  }

  .thumb:hover .scrim {
    opacity: 1;
  }

  .star {
    position: absolute;
    top: 14px;
    left: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--color-gold-bright);
    z-index: 2;
  }

  .pbadge {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 118px;
    height: 118px;
    border-radius: 50%;
    border: 1.5px solid rgba(245, 242, 206, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 12px;
    color: var(--color-cream-light);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 3;
  }

  .thumb:hover .pbadge {
    opacity: 1;
    transform: scale(1);
  }

  .pbody {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .ptitle {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    color: var(--color-cream-light);
    margin: 0 0 8px;
  }

  .pcard-featured .ptitle {
    font-size: 1.6rem;
  }

  .pdesc {
    color: #aeb8ac;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 16px;
  }

  .ptags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .ptag {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-mint);
    border: 1px solid rgba(150, 205, 176, 0.18);
  }
</style>
