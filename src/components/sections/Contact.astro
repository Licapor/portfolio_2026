---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { socialLinks, whatsappLink } from '../../content/social';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Ofuscación del email para evitar scrapers
const emailParts = {
  user: 'liliana',
  domain: 'licapor',
  tld: 'dev'
};

const links = [
  ...socialLinks.map((l) => ({ name: l.name, url: l.url, note: null as string | null })),
  { name: 'WhatsApp', url: whatsappLink, note: t('contact.whatsappLabel') },
];
---

<section id="contact" class="contact-band relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 relative">
    <div class="contact-grid">
      <!-- Left: statement + email -->
      <div class="reveal">
        <!-- Cabecera propia en vez de SectionHeader: aquí el label es el prompt de
             la sesión. Es la única sección que lo necesita, así que va inline en vez
             de meterle una variante al componente compartido. -->
        <div class="mb-8">
          <p class="session-cmd" aria-hidden="true">$ session.open<span class="hero-caret"></span></p>
          <span class="sr-only">{t('contact.label')}</span>
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-bold text-gray-900 mt-2">
            {t('contact.title')} <span class="text-outline">{t('contact.titleOutline')}</span>
          </h2>
        </div>
        <p class="contact-desc">
          {t('contact.description')}
        </p>

        <a
          id="email-link"
          href="#"
          class="contact-email hover-underline"
          data-u={emailParts.user}
          data-d={emailParts.domain}
          data-t={emailParts.tld}
        >
          <span class="email-text">{emailParts.user}[at]{emailParts.domain}[dot]{emailParts.tld}</span>
        </a>
      </div>

      <!-- Right: mono link index -->
      <ul class="contact-links reveal stagger-2">
        {links.map((link, i) => (
          <li>
            <a class="contact-link" href={link.url} target="_blank" rel="noopener noreferrer">
              <span class="link-idx" aria-hidden="true">[{String(i + 1).padStart(2, '0')}]</span>
              <span class="link-name">{link.name}</span>
              {link.note && <span class="link-note">{link.note}</span>}
              <svg class="link-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H8m9 0v9" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Bottom watermark marquee -->
    <div class="mt-24 overflow-hidden reveal" aria-hidden="true">
      <div class="flex gap-8 animate-marquee whitespace-nowrap">
        <span class="watermark">{t('contact.marquee')}</span>
        <span class="watermark">{t('contact.marquee')}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-band {
    background: var(--color-bone);
    padding: 96px 0 40px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 64px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  .contact-desc {
    color: rgba(16, 34, 31, 0.72);
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 44ch;
    margin: 0 0 40px;
  }

  .contact-email {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3.6vw, 2.8rem);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
    word-break: break-all;
    transition: color 0.25s ease;
  }

  .contact-email:hover {
    color: var(--color-gold-dark);
  }

  .contact-email:focus-visible,
  .contact-link:focus-visible {
    outline: 2px solid var(--color-gold-dark);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .contact-links {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(16, 34, 31, 0.15);
  }

  .contact-link {
    display: flex;
    align-items: baseline;
    gap: 14px;
    min-height: 44px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(16, 34, 31, 0.15);
    text-decoration: none;
    color: var(--color-ink);
    transition: color 0.25s ease;
  }

  .contact-link:hover {
    color: var(--color-gold-dark);
  }

  .session-cmd {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--color-gold-dark);
    margin: 0;
  }

  /* El caret global es gold-bright, pensado para fondo oscuro. Sobre bone no contrasta. */
  .session-cmd .hero-caret {
    background: var(--color-gold-dark);
  }

  .link-idx {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--color-gold-dark);
  }

  .link-name {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .link-note {
    color: rgba(16, 34, 31, 0.6);
    font-size: 0.92rem;
  }

  .link-arrow {
    width: 18px;
    height: 18px;
    margin-left: auto;
    align-self: center;
    transition: transform 0.25s ease;
  }

  .contact-link:hover .link-arrow {
    transform: translate(3px, -3px);
  }

  .watermark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(4rem, 12vw, 12rem);
    color: rgba(16, 34, 31, 0.06);
    user-select: none;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .animate-marquee {
    animation: marquee 20s linear infinite;
  }
</style>

<script>
  // Desofuscar email para usuarios reales (no bots)
  function initEmailLinks() {
    const emailElements = document.querySelectorAll('[data-u][data-d][data-t]');
    emailElements.forEach(el => {
      const u = el.getAttribute('data-u');
      const d = el.getAttribute('data-d');
      const t = el.getAttribute('data-t');
      if (u && d && t) {
        const email = `${u}@${d}.${t}`;
        el.setAttribute('href', `mailto:${email}`);
        const textEl = el.querySelector('.email-text');
        if (textEl) {
          textEl.textContent = email;
        }
      }
    });
  }

  // Ejecutar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmailLinks);
  } else {
    initEmailLinks();
  }
</script>
