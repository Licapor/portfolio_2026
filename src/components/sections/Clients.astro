---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Real brand logos. Names for the screen-reader list.
const clients = [
  { name: 'Lottus Education', logo: '/logos/clients/lottus.png' },
  { name: 'Nieva', logo: '/logos/clients/nieva.png' },
  { name: 'Xandr', logo: '/logos/clients/xandr.png' },
  { name: 'Segundamano', logo: '/logos/clients/segundamano.png' },
];
// Duplicated once for a seamless -50% marquee loop.
const loop = [...clients, ...clients];
---

<section class="clients-band">
  <p class="clients-label">{t('clients.label')}</p>
  <ul class="sr-only">
    {clients.map((c) => <li>{c.name}</li>)}
  </ul>
  <div class="logo-marquee" aria-hidden="true">
    <div class="logo-track">
      {loop.map((c) => (
        <img class:list={['client-logo', c.name === 'Nieva' && 'is-icon']} src={c.logo} alt="" />
      ))}
    </div>
  </div>
</section>

<style>
  .clients-band {
    background: #ffffff;
    padding: 52px 0 48px;
    text-align: center;
    border-top: 1px solid var(--color-sand);
    border-bottom: 1px solid var(--color-sand);
  }

  .clients-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6e6a5c;
    margin: 0 0 30px;
  }

  .client-logo {
    height: 30px;
    width: auto;
    margin: 0 44px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.55;
    transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  .client-logo.is-icon {
    height: 40px;
  }

  .client-logo:hover {
    filter: grayscale(0);
    opacity: 1;
    transform: translateY(-2px);
  }
</style>
