---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Real brand logos, shown as a static editorial strip.
const clients = [
  { name: 'Lottus Education', logo: '/logos/clients/lottus.png' },
  { name: 'Nieva', logo: '/logos/clients/nieva.png' },
  { name: 'Xandr', logo: '/logos/clients/xandr.png' },
  { name: 'Segundamano', logo: '/logos/clients/segundamano.png' },
];
---

<section class="clients-band" aria-labelledby="clients-label">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <p id="clients-label" class="clients-label">{t('clients.label')}</p>
    <ul class="clients-row">
      {clients.map((c) => (
        <li>
          <img class:list={['client-logo', c.name === 'Nieva' && 'is-icon']} src={c.logo} alt={c.name} loading="lazy" />
        </li>
      ))}
    </ul>
    <p class="clients-note" aria-hidden="true">
      deployments: {clients.map((c) => c.name.split(' ')[0].toLowerCase()).join(' · ')}
    </p>
  </div>
</section>

<style>
  .clients-band {
    background: var(--color-bone);
    padding: 56px 0 52px;
    border-bottom: 1px solid rgba(16, 34, 31, 0.08);
  }

  .clients-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    text-align: center;
    margin: 0 0 34px;
  }

  .clients-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 28px 64px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .client-logo {
    height: 30px;
    width: auto;
    object-fit: contain;
    /* multiply lets white logo boxes melt into the bone background */
    mix-blend-mode: multiply;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  /* Nieva solo existe como icono sobre cuadro oscuro. Sin multiply y a menor
     altura pesa lo mismo que los wordmarks vecinos en vez de leerse como mancha. */
  .client-logo.is-icon {
    height: 26px;
    mix-blend-mode: normal;
    border-radius: 5px;
  }

  .clients-note {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    /* 0.42 daba 2.57:1 sobre bone, debajo del piso AA. 0.65 da 5.02:1. */
    color: rgba(16, 34, 31, 0.65);
    text-align: center;
    margin: 30px 0 0;
  }

  .client-logo:hover {
    filter: grayscale(0);
    opacity: 1;
  }
</style>
