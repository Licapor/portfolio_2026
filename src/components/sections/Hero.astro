---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { heroIdentities } from '../../i18n/translations/hero';
import Marquee from '../ui/Marquee.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const identities = heroIdentities[lang] ?? heroIdentities.es;
---

<section class="hero relative overflow-hidden">
  <div class="grain" aria-hidden="true"></div>

  <div class="hero-inner max-w-7xl mx-auto px-6 lg:px-12">
    <div>
      <p class="eyebrow">{t('hero.eyebrow')}</p>

      <h1 class="title">
        <span class:list={['roleWrap', identities[0].style]} id="roleWrap" aria-hidden="true"><span id="role">{identities[0].text}</span><span class="hero-caret"></span></span>
        <span class="sr-only">{t('hero.srHeadline')}</span>
      </h1>

      <p class="lead">
        {t('hero.leadPre')} <span class="g">{t('hero.leadHl1')}</span> {t('hero.leadMid')} <span class="g">{t('hero.leadHl2')}</span>.
      </p>

      <div class="cta-row">
        <a href="#work" class="btn-hero btn-hero-primary">{t('hero.cta1')}</a>
        <a href="#contact" class="btn-hero btn-hero-outline">{t('hero.cta2')}</a>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="num">{t('hero.yearsNumber')}</div>
        <p>{t('hero.stat1')}</p>
      </div>
      <div class="stat">
        <div class="num">{t('hero.industriesNumber')}</div>
        <p>{t('hero.stat2')}</p>
      </div>
    </div>
  </div>

</section>

<Marquee content={t('hero.marquee')} variant="dark" speed={34} />

<script type="application/json" id="hero-identities" set:html={JSON.stringify(identities)} />

<script>
  import { Scramble } from '../../scripts/scramble';

  type Identity = { text: string; style: string };
  const dataEl = document.getElementById('hero-identities');
  const wrap = document.getElementById('roleWrap');
  const role = document.getElementById('role');

  if (dataEl && wrap && role) {
    const ROLES: Identity[] = JSON.parse(dataEl.textContent || '[]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const s = new Scramble(role);
    let idx = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let paused = false;
    let running = false;

    async function cycle() {
      if (paused) { running = false; return; }
      running = true;
      const { text, style } = ROLES[idx];
      wrap!.className = 'roleWrap ' + style;
      await s.setText(text);
      idx = (idx + 1) % ROLES.length;
      if (paused) { running = false; return; }
      timer = setTimeout(cycle, 2000);
    }

    function start() {
      clearTimeout(timer);
      idx = 0;
      if (reduced) {
        wrap!.className = 'roleWrap ' + ROLES[0].style;
        role!.textContent = ROLES[0].text;
        return;
      }
      running = false;
      cycle();
    }

    function pause() {
      paused = true;
      clearTimeout(timer);
    }

    function resume() {
      if (!paused) return;
      paused = false;
      if (!running && !reduced) cycle();
    }

    start();

    // Pause the loop when the hero is off-screen or the tab is hidden (saves CPU/battery).
    const heroEl = document.querySelector('.hero');
    if (heroEl && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) resume();
          else pause();
        },
        { threshold: 0 }
      );
      io.observe(heroEl);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause();
      else resume();
    });
  }
</script>

<style>
  .hero {
    min-height: 100vh;
    padding: 150px 0 0;
    color: var(--color-cream-light);
    background:
      radial-gradient(900px 560px at 88% 4%, rgba(90, 143, 118, 0.3), transparent 60%),
      radial-gradient(700px 480px at 4% 96%, rgba(217, 172, 99, 0.14), transparent 55%),
      linear-gradient(150deg, #0c201c, #16302b 55%, #0c201c);
  }

  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    pointer-events: none;
    background-image: radial-gradient(rgba(255, 255, 255, 0.6) 0.5px, transparent 0.5px);
    background-size: 4px 4px;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 44px;
    align-items: center;
    min-height: calc(100vh - 250px);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-bright);
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .eyebrow::before {
    content: '';
    width: 30px;
    height: 1.5px;
    background: var(--color-gold-bright);
    display: inline-block;
  }

  .title {
    margin: 0;
    min-height: clamp(8.5rem, 22vw, 12.5rem);
    display: flex;
    align-items: center;
  }

  .lead {
    font-size: clamp(1.05rem, 2.2vw, 1.42rem);
    color: #c7cbb8;
    font-weight: 300;
    max-width: 33ch;
    margin: 30px 0 0;
    line-height: 1.5;
  }

  .lead .g {
    font-weight: 600;
    background: linear-gradient(120deg, var(--color-mint), var(--color-gold-bright));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .stat {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(150, 205, 176, 0.2);
    border-radius: 20px;
    padding: 24px;
    backdrop-filter: blur(6px);
  }

  .stat .num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2.8rem;
    line-height: 1;
    background: linear-gradient(120deg, var(--color-mint), var(--color-gold-bright));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat p {
    margin: 10px 0 0;
    color: #aeb8ac;
    font-size: 14px;
  }

  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 38px;
  }

  .btn-hero {
    font-weight: 800;
    font-size: 15px;
    padding: 14px 26px;
    border-radius: 999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.2s ease;
  }

  .btn-hero-primary {
    background: linear-gradient(135deg, var(--color-mint), var(--color-gold-bright));
    color: #0c201c;
    box-shadow: 0 12px 30px -12px rgba(150, 205, 176, 0.6);
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
  }

  .btn-hero-outline {
    border: 1.5px solid var(--color-mint);
    color: var(--color-mint);
  }

  .btn-hero-outline:hover {
    background: var(--color-mint);
    color: #0c201c;
  }

</style>
