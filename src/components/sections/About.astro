---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import SectionHeader from '../ui/SectionHeader.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="about-band">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-24 lg:pt-32 pb-20 lg:pb-28">
    <SectionHeader
      labelKey="about.label"
      titleKey="about.title"
      titleOutlineKey="about.titleOutline"
      class="mb-16"
    />

    <div class="about-grid">
      <div class="about-main reveal">
        <h3 class="about-intro">
          {t('about.intro')}
          <span class="gradient-text">{t('about.introHighlight')}</span>
        </h3>
        <p class="about-desc">{t('about.description')}</p>
      </div>

      <dl class="about-dossier reveal stagger-2">
        <div class="dossier-row">
          <dt>{t('about.locationLabel')}</dt>
          <dd>{t('about.location')}</dd>
        </div>
        <div class="dossier-row">
          <dt>{t('about.languagesLabel')}</dt>
          <dd>{t('about.languages')}</dd>
        </div>
        <div class="dossier-row">
          <dt>{t('about.currentlyLabel')}</dt>
          <dd>
            {t('about.currently')}
            <span class="dossier-note">
              {t('about.currentlyWith')}<a href="https://nieva.team/es" target="_blank" rel="noopener noreferrer">Nieva Team</a>
            </span>
          </dd>
        </div>
        <div class="dossier-row">
          <dt>{t('about.adventuresLabel')}</dt>
          <dd>{t('about.adventures')}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about-band {
    background: var(--color-bone);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 64px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  .about-intro {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 26px;
    max-width: 24ch;
  }

  .about-desc {
    color: rgba(16, 34, 31, 0.72);
    font-size: 1.1rem;
    line-height: 1.65;
    margin: 0;
    max-width: 60ch;
  }

  .about-dossier {
    margin: 0;
    border-top: 1px solid rgba(16, 34, 31, 0.15);
  }

  .dossier-row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(16, 34, 31, 0.15);
  }

  @media (max-width: 480px) {
    .dossier-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  .dossier-row dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    padding-top: 3px;
  }

  .dossier-row dd {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .dossier-note {
    display: block;
    color: rgba(16, 34, 31, 0.72);
    font-size: 0.95rem;
    margin-top: 2px;
  }

  .dossier-note a {
    color: var(--color-gold-dark);
    text-decoration: none;
  }

  .dossier-note a:hover {
    text-decoration: underline;
  }

  .dossier-note a:focus-visible {
    outline: 2px solid var(--color-gold-dark);
    outline-offset: 2px;
    border-radius: 3px;
  }
</style>
