---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { stackCategories } from '../../content/stack';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="stack" class="stack-band">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="stack-head reveal">
      <p class="stack-label">{t('stack.label')}</p>
      <h2 class="stack-title">
        {t('stack.title')} <span class="stack-outline">{t('stack.titleOutline')}</span>
      </h2>
      <p class="stack-intro">{t('stack.intro')}</p>
    </div>

    <div class="spec-table">
      {stackCategories.map((cat, i) => (
        <div class:list={['spec-row reveal', `stagger-${(i % 6) + 1}`]}>
          <span class="spec-idx" aria-hidden="true">{pad(i + 1)}</span>
          <h3 class="spec-cat">
            {t(cat.titleKey)}
            <span class="spec-count" aria-hidden="true">({pad(cat.items.length)})</span>
          </h3>
          <p class="spec-items">{cat.items.join(' · ')}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-band {
    background: var(--color-bone);
    padding: 80px 0 90px;
  }

  .stack-head {
    max-width: 640px;
    margin-bottom: 56px;
  }

  .stack-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    margin: 0 0 12px;
  }

  .stack-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.2rem);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 14px;
  }

  .stack-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-sage);
  }

  .stack-intro {
    color: rgba(16, 34, 31, 0.72);
    font-size: 1.05rem;
    line-height: 1.55;
    margin: 0;
  }

  /* Spec sheet: hairlines + mono indices, no cards */
  .spec-table {
    border-top: 1px solid rgba(16, 34, 31, 0.15);
  }

  .spec-row {
    display: grid;
    grid-template-columns: 3.5rem minmax(13rem, 17rem) 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid rgba(16, 34, 31, 0.15);
    transition: background 0.25s ease;
  }

  .spec-row:hover {
    background: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 768px) {
    .spec-row {
      grid-template-columns: 3.5rem 1fr;
      gap: 10px 16px;
      padding: 22px 0;
    }

    .spec-items {
      grid-column: 1 / -1;
    }
  }

  .spec-idx {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-gold-dark);
  }

  .spec-cat {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }

  .spec-count {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    color: var(--color-gold-dark);
    margin-left: 10px;
    letter-spacing: 0.04em;
  }

  .spec-items {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.9;
    color: rgba(16, 34, 31, 0.75);
    margin: 0;
  }
</style>
