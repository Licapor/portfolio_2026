---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { stackCategories } from '../../content/stack';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pad = (n: number) => String(n).padStart(2, '0');
const slug = (s: string) =>
  s
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '_')
    .replace(/^_+|_+$/g, '');

const totalTools = stackCategories.reduce((n, c) => n + c.items.length, 0);
---

<section id="stack" class="stack-band">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="stack-head reveal">
      <p class="stack-label">{t('stack.label')}</p>
      <h2 class="stack-title">
        {t('stack.title')} <span class="stack-outline">{t('stack.titleOutline')}</span>
      </h2>
      <p class="stack-intro">{t('stack.intro')}</p>
    </div>

    <!-- Agent OS: the skill set as the agent's tool manifest -->
    <div class="terminal reveal stagger-2">
      <div class="term-bar" aria-hidden="true">
        <span class="term-title">agent.tools — manifest</span>
        <span class="term-meta">{pad(stackCategories.length)} groups · {totalTools} tools</span>
      </div>

      <div class="term-body">
        <p class="term-cmd" aria-hidden="true">$ agent.tools --list<span class="hero-caret"></span></p>

        {stackCategories.map((cat, i) => (
          <div class:list={['tool-row reveal', `stagger-${(i % 6) + 1}`]}>
            <h3 class="tool-name">
              <span class="sr-only">{t(cat.titleKey)}</span>
              <span class="tool-line" aria-hidden="true">
                <span class="tool-idx">[{pad(i + 1)}]</span>
                <span class="tool-slug" data-slug={slug(t(cat.titleKey))}>{slug(t(cat.titleKey))}</span>
                <span class="tool-dots"></span>
                <span class="tool-status">[ACTIVE] ({pad(cat.items.length)})</span>
              </span>
            </h3>
            <p class="tool-items">{cat.items.join(' · ')}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { Scramble } from '../../scripts/scramble';

  // Cada grupo del manifest se decodifica al entrar en viewport, una sola vez.
  // El nombre real de la categoría vive en el .sr-only hermano, que no se toca.
  const slugs = document.querySelectorAll<HTMLElement>('.tool-slug');

  if (slugs.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const running = new Map<HTMLElement, Scramble>();

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          obs.unobserve(el);
          const text = el.dataset.slug || el.textContent || '';
          const delay = Number(el.dataset.order || 0) * 90;
          // Scramble arranca con text = '', así que la línea se decodifica desde
          // cero en vez de glitchear sobre sí misma. Con la pestaña oculta no hay
          // frames de rAF: se deja el texto que ya vino del servidor.
          setTimeout(() => {
            if (document.hidden) return;
            const s = new Scramble(el);
            running.set(el, s);
            s.setText(text).then(() => running.delete(el));
          }, delay);
        });
      },
      { threshold: 0.6 }
    );

    slugs.forEach((el, i) => {
      el.dataset.order = String(i);
      observer.observe(el);
    });

    // Si la pestaña se oculta a media animación, rAF se detiene y la fila queda
    // en caracteres basura. Se cancela el frame pendiente (si no, al volver el
    // foco reanudaría y volvería a ensuciar el texto) y se asienta el final.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) return;
      running.forEach((s, el) => {
        cancelAnimationFrame(s.raf);
        el.textContent = el.dataset.slug || '';
      });
      running.clear();
    });
  }
</script>

<style>
  .stack-band {
    background: var(--color-bone);
    padding: 80px 0 90px;
  }

  .stack-head {
    max-width: 640px;
    margin-bottom: 48px;
  }

  .stack-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    margin: 0 0 12px;
  }

  .stack-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.2rem);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 14px;
  }

  .stack-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-sage);
  }

  .stack-intro {
    color: rgba(16, 34, 31, 0.72);
    font-size: 1.05rem;
    line-height: 1.55;
    margin: 0;
  }

  /* ===== Terminal panel ===== */
  .terminal {
    background:
      radial-gradient(700px 400px at 90% 0%, rgba(90, 143, 118, 0.18), transparent 60%),
      linear-gradient(165deg, #0c201c, #16302b);
    border: 1px solid rgba(150, 205, 176, 0.25);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 34px 70px -34px rgba(12, 32, 28, 0.5);
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 24px;
    border-bottom: 1px solid rgba(150, 205, 176, 0.15);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .term-title {
    color: var(--color-gold-bright);
  }

  .term-meta {
    color: rgba(150, 205, 176, 0.75);
  }

  .term-body {
    padding: 26px 24px 30px;
  }

  @media (min-width: 768px) {
    .term-body {
      padding: 30px 34px 36px;
    }
  }

  .term-cmd {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-mint);
    margin: 0 0 26px;
  }

  .tool-row {
    margin-bottom: 22px;
  }

  .tool-row:last-child {
    margin-bottom: 0;
  }

  .tool-name {
    margin: 0 0 8px;
  }

  .tool-line {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 15px;
  }

  .tool-idx {
    color: var(--color-gold-bright);
  }

  .tool-slug {
    color: var(--color-mint);
  }

  .tool-dots {
    flex: 1;
    min-width: 20px;
    border-bottom: 1px dotted rgba(150, 205, 176, 0.3);
    transform: translateY(-4px);
  }

  .tool-status {
    color: var(--color-gold-bright);
    font-size: 12.5px;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .tool-items {
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.9;
    color: #c7cbb8;
    margin: 0;
    padding-left: 3rem;
    max-width: 72ch;
  }

  @media (max-width: 640px) {
    .tool-items {
      padding-left: 0;
    }

    .tool-status {
      font-size: 11.5px;
    }
  }
</style>
